APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production checklist:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain
#   LOG_LEVEL=warning
#   SESSION_ENCRYPT=true
#   SESSION_SECURE_COOKIE=true
# HTTPS is forced automatically when APP_ENV=production.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=store_app
DB_USERNAME=
DB_PASSWORD=

SANCTUM_EXPIRATION=120

ORDER_PENDING_EXPIRES_MINUTES=60
CART_MAX_LINE_QUANTITY=99

PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=usd
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=laravel-session
SESSION_SERIALIZATION=json

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=laravel-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
